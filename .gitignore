# ---- Cargo / Rust ----
# Build artifacts
/target/
debug/
release/

# Cargo.lock is committed for binaries/applications (reproducible builds)
# and ignored only for libraries. This project is an application, so keep it tracked.
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# ---- Coverage / profiling ----
*.profraw
*.profdata
lcov.info
coverage/
# grcov-generated HTML reports (keep committed docs/gcov-html if you deploy it via Pages)
# docs/gcov-html/

# ---- Editors / IDEs ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Misc ----
*.log
*.tmp